<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="#FFF8F5"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/experienceImage"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/experience_photo_preview"
        android:scaleType="centerCrop" />


    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:textColor="#202124"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/descriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="#656168"
        android:textSize="16sp" />

    <!-- Each detail has its own icon and text. -->

    <!-- Country details with a flag icon -->
    <TextView
        android:id="@+id/countryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:drawableStart="@drawable/country_icon"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:textColor="#202124"
        android:textSize="14sp" />


    <!-- City details with a location icon. -->
    <TextView
        android:id="@+id/cityText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:drawableStart="@drawable/city_icon"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:textColor="#202124"
        android:textSize="14sp" />

    <!-- Experience type with a category icon. -->
    <TextView
        android:id="@+id/typeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:drawableStart="@drawable/type_icon"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:textColor="#202124"
        android:textSize="14sp" />


    <!-- Date visited with a calendar icon. -->
    <TextView
        android:id="@+id/dateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:drawableStart="@drawable/calendar_icon"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:textColor="#202124"
        android:textSize="14sp" />


    <!-- Rating out of five with a star icon. -->
    <TextView
        android:id="@+id/ratingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:drawableStart="@drawable/rating_icon"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:textColor="#202124"
        android:textSize="14sp" />


</LinearLayout>