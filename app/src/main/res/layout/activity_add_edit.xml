<?xml version="1.0" encoding="utf-8"?>
<!-- Add a travel experience page -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFF8F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">


        <!-- Heading for the add or edit form -->
        <TextView
            android:id="@+id/formTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Add Travel Experience"
            android:textColor="#202124"
            android:textSize="28sp"
            android:textStyle="bold" />


        <!-- The Title label moves above the text when the field is used -->
        <!-- Red for the floating label -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="12dp"
            android:hint="Title"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="#B32635"
            app:hintTextColor="#B32635">


            <!-- Enter the experience title. -->
            <!-- background="@null": remove the default underline. -->
            <EditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@null"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#202124"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Description"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="#B32635"
            app:hintTextColor="#B32635">


            <!-- Allow the description to span multiple lines. -->
            <EditText
                android:id="@+id/descriptionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:background="@null"
                android:backgroundTint="#B32635"
                android:ems="10"
                android:hint="Description "
                android:inputType="text|textMultiLine"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="#202124"
                android:textColorHint="#656168"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Country"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="#B32635"
            app:hintTextColor="#B32635">

            <EditText
                android:id="@+id/countryInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:backgroundTint="#B32635"
                android:ems="10"
                android:hint="Country"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#202124"
                android:textColorHint="#656168"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="City"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="#B32635"
            app:hintTextColor="#B32635">

            <EditText
                android:id="@+id/cityInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:backgroundTint="#B32635"
                android:ems="10"
                android:hint="City"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#202124"
                android:textColorHint="#656168"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>


        <!-- Type dropdown with a red arrow on the right -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Type (Landmark, Restaurant or Activity)"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="#B32635"
            app:endIconMode="dropdown_menu"
            app:endIconTint="#B32635"
            app:hintTextColor="#B32635">

            <!-- Dropdown for selecting Landmark, Restaurant or Activity. -->
            <!-- inputType="none" prevents keyboard typing. -->
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/typeInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@null"
                android:inputType="none"
                android:padding="12dp"
                android:textColor="#202124"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- Date Visited field with a red calendar icon at the start. -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Date Visited (DD/MM/YYYY)"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="#B32635"
            app:hintTextColor="#B32635"
            app:startIconDrawable="@drawable/calendar_icon"
            app:startIconTint="#B32635">


            <!-- Display the date chosen using the calendar picker. -->
            <EditText
                android:id="@+id/dateVisitedInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:backgroundTint="#B32635"
                android:ems="10"
                android:inputType="date"
                android:padding="12dp"
                android:textColor="#202124"
                android:textColorHint="#656168"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Rating (1–5)"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="#B32635"
            app:hintTextColor="#B32635">

            <EditText
                android:id="@+id/ratingInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:backgroundTint="#B32635"
                android:ems="10"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#202124"
                android:textColorHint="#656168"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>


        <!-- Save the new or edited experience. -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#B32635"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:cornerRadius="8dp" />


        <!-- Return without saving changes. -->
        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FFF8F5"
            android:text="Cancel"
            android:textColor="#B32635"
            android:textSize="18sp"
            app:cornerRadius="8dp"
            app:strokeColor="#B32635"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>