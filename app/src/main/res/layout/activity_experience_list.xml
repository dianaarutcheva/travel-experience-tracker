<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ExperienceListActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF8F5"
        android:orientation="vertical"
        android:padding="24dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">


        <!-- Heading for the experience list. -->
        <TextView
            android:id="@+id/experiencesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Travel Experiences"
            android:textColor="#202124"
            android:textSize="28sp"
            android:textStyle="bold" />


        <!-- SEARCH -->
        <!-- Create the border and label around the search input -->
        <!-- Show "Search experiences..." as the label -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Search experiences..."
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#B32635"
            app:hintTextColor="#B32635"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp">

            <!-- Text field where the user types an experience name -->
            <!-- searchInput is the ID used to find this field in Kotlin -->
            <!-- inputType="text" allows text entry using the keyboard -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#202124"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>




        <!-- Show the experiences below the search box. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/experiencesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <!-- Return to the main menu. -->
        <Button
            android:id="@+id/returnButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FFF8F5"
            android:text="Back to menu"
            android:textColor="#B32635"
            android:textSize="18sp"
            app:cornerRadius="8dp"
            app:strokeColor="#B32635"
            app:strokeWidth="1dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>